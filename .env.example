# Copy to .env and fill in. Never commit .env.
PI_HOST=skyguard-pi.local        # or the Pi's IP; over the Ethernet adapter use 10.42.0.2 (see HARDWARE_SETUP.md)
PI_USER=pi
UNOQ_HOST=unoq.local             # UNO Q hostname / IP on the hotspot
UNOQ_USER=arduino
HUB_URL=http://<PI_IP_ON_HOTSPOT>:8000   # what Node B posts to
NEST_NAME=Nest Mini              # Chromecast friendly name from the Google Home app
SKYGUARD_PROFILE=pi              # sim | laptop | pi | unoq
ALSA_DEVICE=default              # arecord -l to find the webcam mic, e.g. plughw:1,0

# Optional: shared secret so a rogue device on the hotspot cannot inject/forge detections (set the same value on Pi and UNO Q)
INGEST_KEY=
